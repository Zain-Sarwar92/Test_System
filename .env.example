# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file.
#
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Database (PostgreSQL) ---
# Local (recommended for dev — fast, no cloud latency):
#   npm run db:local:up
#   npm run db:local:setup
DATABASE_URL="postgresql://testhub:testhub_local@127.0.0.1:5432/test_hub?schema=public"

# --- App URLs ---
# Local: http://localhost:5001
# Production: https://your-domain.com  (HTTPS required)
APP_URL="https://your-domain.com"
BETTER_AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# --- Better Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be 32+ characters. Never reuse the example value below.
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_32PLUS_CHAR_SECRET"
# Optional: comma-separated extra origins (e.g. LAN IP for phone testing).
# Do not use wildcards like https://*.vercel.app
# BETTER_AUTH_TRUSTED_ORIGINS="http://10.0.0.5:5001"

# --- API JSON envelope (obfuscation for /api JSON bodies) ---
# Falls back to BETTER_AUTH_SECRET if unset. Generate a separate value in production.
# API_ENVELOPE_SECRET="REPLACE_WITH_RANDOM_ENVELOPE_SECRET"

# --- Cron (/api/cron/test-reminders) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Send as Authorization: Bearer <CRON_SECRET>
CRON_SECRET="REPLACE_WITH_RANDOM_CRON_SECRET"

# --- SMTP (test schedule reminders) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@example.com"
SMTP_PASS="your-smtp-or-app-password"
EMAIL_FROM="Test Hub <noreply@your-domain.com>"

# --- Seed credentials (DEV / FIRST SETUP ONLY) ---
# Do NOT use weak defaults like Admin@12345 in production.
# In production: set a unique strong password, or create the Super Admin
# out-of-band and omit these after the first seed.
SEED_SUPER_ADMIN_EMAIL="admin@your-domain.com"
SEED_SUPER_ADMIN_PASSWORD="REPLACE_WITH_STRONG_UNIQUE_PASSWORD"
SEED_SUPER_ADMIN_NAME="Super Admin"
