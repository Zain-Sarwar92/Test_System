    },
    {
      "QuestionID": 530881,
      "SubjectID": 123,
      "TopicID": 15521,
      "TopicRef": ".",
      "TopicName": ". BECAUSE I COULD NOT  STOP FOR DEATH  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">We paused before a House that seemed</p>\r\n\r\n<p style=\"text-align: center;\">A Swelling of the Ground –</p>\r\n\r\n<p style=\"text-align: center;\">The Roof was scarcely visible –</p>\r\n\r\n<p style=\"text-align: center;\">The Cornice – in the Ground –</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 530883,
      "SubjectID": 123,
      "TopicID": 15521,
      "TopicRef": ".",
      "TopicName": ". BECAUSE I COULD NOT  STOP FOR DEATH  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">Since then – 'tis Centuries – and yet</p>\r\n\r\n<p style=\"text-align: center;\">Feels shorter than the Day</p>\r\n\r\n<p style=\"text-align: center;\">I first surmised the Horses' Heads</p>\r\n\r\n<p style=\"text-align: center;\">Were toward Eternity –</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
