    {
      "QuestionID": 530866,
      "SubjectID": 123,
      "TopicID": 15517,
      "TopicRef": ".",
      "TopicName": ". ON HIS BLINDNESS  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">When I consider how my light is spent,</p>\r\n\r\n<p style=\"text-align: center;\">Ere half my days, in this dark world and wide,</p>\r\n\r\n<p style=\"text-align: center;\">And that one talent which is death to hide</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 530867,
      "SubjectID": 123,
      "TopicID": 15517,
      "TopicRef": ".",
      "TopicName": ". ON HIS BLINDNESS  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">Lodged with me useless, though my Soul more bent</p>\r\n\r\n<p style=\"text-align: center;\">To serve therewith my Maker, and present</p>\r\n\r\n<p style=\"text-align: center;\">My true account, lest he returning chide;</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 530868,
      "SubjectID": 123,
      "TopicID": 15517,
      "TopicRef": ".",
      "TopicName": ". ON HIS BLINDNESS  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">“Doth God exact day-labour, light denied?”</p>\r\n\r\n<p style=\"text-align: center;\">I fondly ask. But Patience, to prevent</p>\r\n\r\n<p style=\"text-align: center;\">That murmur, soon replies, “God doth not need</p>\r\n\r\n<p style=\"text-align: center;\"> </p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 530869,
      "SubjectID": 123,
      "TopicID": 15517,
      "TopicRef": ".",
      "TopicName": ". ON HIS BLINDNESS  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">Either man’s work or his own gifts; who best</p>\r\n\r\n<p style=\"text-align: center;\">Bear his mild yoke, they serve him best. His state</p>\r\n\r\n<p style=\"text-align: center;\">Is kingly. Thousands at his bidding speed</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 530870,
      "SubjectID": 123,
      "TopicID": 15517,
      "TopicRef": ".",
      "TopicName": ". ON HIS BLINDNESS  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">And post o’er Land and Ocean without rest:</p>\r\n\r\n<p style=\"text-align: center;\">They also serve who only stand and wait.”</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
