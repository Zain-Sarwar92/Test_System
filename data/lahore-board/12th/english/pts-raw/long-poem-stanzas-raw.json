    {
      "QuestionID": 530871,
      "SubjectID": 123,
      "TopicID": 15521,
      "TopicRef": ".",
      "TopicName": ". BECAUSE I COULD NOT  STOP FOR DEATH  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">Because I could not stop for Death –</p>\r\n\r\n<p style=\"text-align: center;\">He kindly stopped for me –</p>\r\n\r\n<p style=\"text-align: center;\">The Carriage held but just Ourselves –</p>\r\n\r\n<p style=\"text-align: center;\">And Immortality.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 530874,
      "SubjectID": 123,
      "TopicID": 15521,
      "TopicRef": ".",
      "TopicName": ". BECAUSE I COULD NOT  STOP FOR DEATH  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">We slowly drove – He knew no haste</p>\r\n\r\n<p style=\"text-align: center;\">And I had put away</p>\r\n\r\n<p style=\"text-align: center;\">My labor and my leisure too,</p>\r\n\r\n<p style=\"text-align: center;\">For His Civility –</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 530877,
      "SubjectID": 123,
      "TopicID": 15521,
      "TopicRef": ".",
      "TopicName": ". BECAUSE I COULD NOT  STOP FOR DEATH  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">We passed the School, where Children strove</p>\r\n\r\n<p style=\"text-align: center;\">At Recess – in the Ring –</p>\r\n\r\n<p style=\"text-align: center;\">We passed the Fields of Gazing Grain –</p>\r\n\r\n<p style=\"text-align: center;\">We passed the Setting Sun –</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 530879,
      "SubjectID": 123,
      "TopicID": 15521,
      "TopicRef": ".",
      "TopicName": ". BECAUSE I COULD NOT  STOP FOR DEATH  (POEM) ",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">Or rather – He passed Us –</p>\r\n\r\n<p style=\"text-align: center;\">The Dews drew quivering and Chill –</p>\r\n\r\n<p style=\"text-align: center;\">For only Gossamer, my Gown –</p>\r\n\r\n<p style=\"text-align: center;\">My Tippet – only Tulle –</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
