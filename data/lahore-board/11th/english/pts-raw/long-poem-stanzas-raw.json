    {
      "QuestionID": 441489,
      "SubjectID": 101,
      "TopicID": 12189,
      "TopicRef": "3",
      "TopicName": "3 A BIRD CAME DOWN THE WALK (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>Like one in danger,  <strong>Cautious</strong></p>\r\n\r\n<p>I offered him a Crumb</p>\r\n\r\n<p>And he  <strong>unrolled</strong>  his feathers</p>\r\n\r\n<p>And  <strong>rowed</strong>  him softer home</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
