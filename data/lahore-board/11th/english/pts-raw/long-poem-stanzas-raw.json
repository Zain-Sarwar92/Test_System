    {
      "QuestionID": 441507,
      "SubjectID": 101,
      "TopicID": 12192,
      "TopicRef": "6",
      "TopicName": "6 THE ECHOING GREEN (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>The sun does arise,</p>\r\n\r\n<p>And make happy the skies.</p>\r\n\r\n<p>The  <strong>merry</strong>  bells ring</p>\r\n\r\n<p>To welcome the spring.</p>\r\n\r\n<p>The sky-lark and  <strong>thrush</strong></p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 441513,
      "SubjectID": 101,
      "TopicID": 12192,
      "TopicRef": "6",
      "TopicName": "6 THE ECHOING GREEN (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>The birds of the bush,</p>\r\n\r\n<p>Sing louder around,</p>\r\n\r\n<p>To the bells  <strong>cheerful</strong>  sound.</p>\r\n\r\n<p>While our sports shall be seen</p>\r\n\r\n<p>On the  <strong>Echoing</strong>  Green.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 441519,
      "SubjectID": 101,
      "TopicID": 12192,
      "TopicRef": "6",
      "TopicName": "6 THE ECHOING GREEN (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>Old John, with white hair</p>\r\n\r\n<p>Does laugh away care,</p>\r\n\r\n<p>Sitting under the oak,</p>\r\n\r\n<p>Among the old folk,</p>\r\n\r\n<p>They laugh at our play,</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 441547,
      "SubjectID": 101,
      "TopicID": 12192,
      "TopicRef": "6",
      "TopicName": "6 THE ECHOING GREEN (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>And soon they all say.</p>\r\n\r\n<p>Such, such were the joys.</p>\r\n\r\n<p>When we all girls & boys,</p>\r\n\r\n<p>In our  <strong>Youth </strong>-time were seen,</p>\r\n\r\n<p>On the <strong>Echoing</strong> Green.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
