    {
      "QuestionID": 441571,
      "SubjectID": 101,
      "TopicID": 12195,
      "TopicRef": "9",
      "TopicName": "9 Freedom",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>Freedom will not come</p>\r\n\r\n<p>today, this year nor ever</p>\r\n\r\n<p>through  <strong>compromise</strong>  and  <strong>fear</strong>.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 441573,
      "SubjectID": 101,
      "TopicID": 12195,
      "TopicRef": "9",
      "TopicName": "9 Freedom",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>I have as much right</p>\r\n\r\n<p>as the other  <strong>follow</strong>  has to stand</p>\r\n\r\n<p>on my two feet</p>\r\n\r\n<p>and  <strong>own</strong>  the land.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 441575,
      "SubjectID": 101,
      "TopicID": 12195,
      "TopicRef": "9",
      "TopicName": "9 Freedom",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>I  <strong>tire</strong>  so of hearing people say,</p>\r\n\r\n<p>Let things take their  <strong>course</strong>.</p>\r\n\r\n<p>Tommorrow is another day.</p>\r\n\r\n<p>I do not need my freedom when i'm dead.</p>\r\n\r\n<p>I cannot live on tomorrow's  <strong>bread</strong>.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 441579,
      "SubjectID": 101,
      "TopicID": 12195,
      "TopicRef": "9",
      "TopicName": "9 Freedom",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>Freedom is a strong seed planted in a great need</p>\r\n\r\n<p>I live here, too.</p>\r\n\r\n<p>I want my freedom just as you.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
