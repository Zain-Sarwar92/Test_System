    {
      "QuestionID": 441584,
      "SubjectID": 101,
      "TopicID": 12199,
      "TopicRef": "13",
      "TopicName": "13 RUBA'IYAT (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>Faith is like Abraham at the  <strong>stake</strong>;  to be</p>\r\n\r\n<p>Self-honoring and  <strong>God-drunk,</strong>  is faith. Hear me,</p>\r\n\r\n<p>you whom this age's way so  <strong>captivate</strong>!</p>\r\n\r\n<p>To have no faith is worse than slavery.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
