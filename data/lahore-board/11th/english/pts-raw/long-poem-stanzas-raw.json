    {
      "QuestionID": 441480,
      "SubjectID": 101,
      "TopicID": 12189,
      "TopicRef": "3",
      "TopicName": "3 A BIRD CAME DOWN THE WALK (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>And then he drank a  <strong>Dew</strong></p>\r\n\r\n<p>From a  <strong>Convenient</strong>  Grass</p>\r\n\r\n<p>And then hopped sidewise to the Wall</p>\r\n\r\n<p>To let a  <strong>Beetle</strong>  pass</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
