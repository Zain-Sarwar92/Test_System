    {
      "QuestionID": 441482,
      "SubjectID": 101,
      "TopicID": 12189,
      "TopicRef": "3",
      "TopicName": "3 A BIRD CAME DOWN THE WALK (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>He  <strong>glanced</strong>  with rapid eyes</p>\r\n\r\n<p>That hurried all around</p>\r\n\r\n<p>They looked like frightened  <strong>Beads</strong>,  I thought</p>\r\n\r\n<p>He started his  <strong>Velvet</strong>  Head</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
