    {
      "QuestionID": 441499,
      "SubjectID": 101,
      "TopicID": 12189,
      "TopicRef": "3",
      "TopicName": "3 A BIRD CAME DOWN THE WALK (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>The  <strong>Oars</strong>  divide the Ocean,</p>\r\n\r\n<p>Too silver for a  <strong>seam</strong></p>\r\n\r\n<p>Or Butterflies, off Banks of Noon</p>\r\n\r\n<p>Leap,  <strong>plashless</strong>  as they swim</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
