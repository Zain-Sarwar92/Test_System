    },
    {
      "QuestionID": 441555,
      "SubjectID": 101,
      "TopicID": 12192,
      "TopicRef": "6",
      "TopicName": "6 THE ECHOING GREEN (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>Till the little ones  <strong>weary</strong></p>\r\n\r\n<p>No more can be merry</p>\r\n\r\n<p>The sun does  <strong>descend</strong>,</p>\r\n\r\n<p>And our sports have an end:</p>\r\n\r\n<p>Round the  <strong>laps</strong>  of their mothers,</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 441556,
      "SubjectID": 101,
      "TopicID": 12192,
      "TopicRef": "6",
      "TopicName": "6 THE ECHOING GREEN (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>Many sisters and brothers,</p>\r\n\r\n<p>Like birds in their nest,</p>\r\n\r\n<p>Are ready for rest;</p>\r\n\r\n<p>And sport no more seen,</p>\r\n\r\n<p>On the darkening Green.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
