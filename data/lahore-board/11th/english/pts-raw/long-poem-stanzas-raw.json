      "TopicName": "3 A BIRD CAME DOWN THE WALK (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>A Bird came down the Walk<br />\r\nHe did not know I saw<br />\r\nHe bit an <strong>Angleworm</strong> in <strong>halves</strong><br />\r\nAnd ate the fellow, raw,</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
