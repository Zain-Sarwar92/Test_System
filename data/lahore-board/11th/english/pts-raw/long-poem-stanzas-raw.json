    {
      "QuestionID": 441585,
      "SubjectID": 101,
      "TopicID": 12199,
      "TopicRef": "13",
      "TopicName": "13 RUBA'IYAT (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>Music of the strange lands with Islam's fire  <strong>blends</strong>,</p>\r\n\r\n<p>On which the nation's  <strong>harmon</strong>y  depends;</p>\r\n\r\n<p>Empty of  <strong>concord</strong>  is the soul Europe,</p>\r\n\r\n<p>Whose civilization to no Makkah bends.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 441587,
      "SubjectID": 101,
      "TopicID": 12199,
      "TopicRef": "13",
      "TopicName": "13 RUBA'IYAT (SMART)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p>Love's madness has  <strong>departed</strong>:  in</p>\r\n\r\n<p>The Muslims's veins the blood runs thin;</p>\r\n\r\n<p><strong>Ranks</strong>  broken, hearts  <strong>perplexed</strong>,  prayers cold,</p>\r\n\r\n<p>No feeling deeper than the skin.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
