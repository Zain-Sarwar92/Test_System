  "questions": [
    {
      "QuestionID": 497019,
      "SubjectID": 64,
      "TopicID": 14863,
      "TopicRef": ".",
      "TopicName": ". MY BELOVED PAKISTAN (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">O land of green, so rich and true,</p>\r\n\r\n<p style=\"text-align: center;\">With skies so wide and rivers blue.</p>\r\n\r\n<p style=\"text-align: center;\">Your mountains stand with pride so high,</p>\r\n\r\n<p style=\"text-align: center;\">Your spirit soars beyond the sky.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 497020,
      "SubjectID": 64,
      "TopicID": 14863,
      "TopicRef": ".",
      "TopicName": ". MY BELOVED PAKISTAN (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">From snowy peaks of mighty North,</p>\r\n\r\n<p style=\"text-align: center;\">To deserts glowing in the South—</p>\r\n\r\n<p style=\"text-align: center;\">Each grain of soil, each blooming tree,</p>\r\n\r\n<p style=\"text-align: center;\">Whispers of love and liberty.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 497021,
      "SubjectID": 64,
      "TopicID": 14863,
      "TopicRef": ".",
      "TopicName": ". MY BELOVED PAKISTAN (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">Your flag of green and star so white,</p>\r\n\r\n<p style=\"text-align: center;\">Shines like a beacon in the night.</p>\r\n\r\n<p style=\"text-align: center;\">We hold it high, both proud and strong,</p>\r\n\r\n<p style=\"text-align: center;\">In every heart, your name belongs.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 497022,
      "SubjectID": 64,
      "TopicID": 14863,
      "TopicRef": ".",
      "TopicName": ". MY BELOVED PAKISTAN (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">For all who serve and strive with grace,</p>\r\n\r\n<p style=\"text-align: center;\">You are our pride, our sacred place.</p>\r\n\r\n<p style=\"text-align: center;\">We'll work, we'll learn, we'll stand as one,</p>\r\n\r\n<p style=\"text-align: center;\">Until the brightest dream is won.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 497023,
      "SubjectID": 64,
      "TopicID": 14863,
      "TopicRef": ".",
      "TopicName": ". MY BELOVED PAKISTAN (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">O Pakistan, my home, my land,</p>\r\n\r\n<p style=\"text-align: center;\">Forever will I make my stand.</p>\r\n\r\n<p style=\"text-align: center;\">With peace and love, I'll do my part—</p>\r\n\r\n<p style=\"text-align: center;\">For you will always own my heart.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 498257,
      "SubjectID": 64,
      "TopicID": 14869,
      "TopicRef": ".",
      "TopicName": ". TIME (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">Unfathomable Sea! whose waves are years,</p>\r\n\r\n<p style=\"text-align: center;\">Ocean of Time, whose waters of deep woe</p>\r\n\r\n<p style=\"text-align: center;\">Are brackish with the salt of human tears!</p>\r\n\r\n<p style=\"text-align: center;\">Thou shoreless flood, which in thy ebb and flow</p>\r\n\r\n<p style=\"text-align: center;\">Claspest the limits of mortality!</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 498259,
      "SubjectID": 64,
      "TopicID": 14869,
      "TopicRef": ".",
      "TopicName": ". TIME (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">And sick of prey, yet howling on for more,</p>\r\n\r\n<p style=\"text-align: center;\">Vomitest thy wrecks on its inhospitable shore;</p>\r\n\r\n<p style=\"text-align: center;\">Treacherous in calm, and terrible in storm,</p>\r\n\r\n<p style=\"text-align: center;\">Who shall put forth on thee,</p>\r\n\r\n<p style=\"text-align: center;\">Unfathomable Sea?</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 498712,
      "SubjectID": 64,
      "TopicID": 14871,
      "TopicRef": ".",
      "TopicName": ". THE ROAD NOT TAKEN (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">Two roads diverged in a yellow wood,</p>\r\n\r\n<p style=\"text-align: center;\">And sorry I could not travel both</p>\r\n\r\n<p style=\"text-align: center;\">And be one traveler, long I stood</p>\r\n\r\n<p style=\"text-align: center;\">And looked down one as far as I could</p>\r\n\r\n<p style=\"text-align: center;\">To where it bent in the undergrowth;</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 498719,
      "SubjectID": 64,
      "TopicID": 14871,
      "TopicRef": ".",
      "TopicName": ". THE ROAD NOT TAKEN (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">Then took the other, as just as fair,</p>\r\n\r\n<p style=\"text-align: center;\">And having perhaps the better claim,</p>\r\n\r\n<p style=\"text-align: center;\">Because it was grassy and wanted wear;</p>\r\n\r\n<p style=\"text-align: center;\">Though as for that the passing there</p>\r\n\r\n<p style=\"text-align: center;\">Had worn them really about the same,</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 498727,
      "SubjectID": 64,
      "TopicID": 14871,
      "TopicRef": ".",
      "TopicName": ". THE ROAD NOT TAKEN (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">And both that morning equally lay</p>\r\n\r\n<p style=\"text-align: center;\">In leaves no step had trodden black.</p>\r\n\r\n<p style=\"text-align: center;\">Oh, I kept the first for another day!</p>\r\n\r\n<p style=\"text-align: center;\">Yet knowing how way leads on to way,</p>\r\n\r\n<p style=\"text-align: center;\">I doubted if I should ever come back.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
      "MultipleOptions": [],
      "_exportMeta": {
        "subTypeId": 47,
        "bankType": "long",
        "field": "POEM_STANZA",
        "exportName": "long-poem-stanzas"
      }
    },
    {
      "QuestionID": 498732,
      "SubjectID": 64,
      "TopicID": 14871,
      "TopicRef": ".",
      "TopicName": ". THE ROAD NOT TAKEN (POEM)",
      "QuestionPeriority": "Additional",
      "UrduQuestionDetails": null,
      "EnglishQuestionDetails": "<p style=\"text-align: center;\">I shall be telling this with a sigh</p>\r\n\r\n<p style=\"text-align: center;\">Somewhere ages and ages hence:</p>\r\n\r\n<p style=\"text-align: center;\">Two roads diverged in a wood, and I—</p>\r\n\r\n<p style=\"text-align: center;\">I took the one less traveled by,</p>\r\n\r\n<p style=\"text-align: center;\">And that has made all the difference.</p>\r\n",
      "UrduFillAnswer": null,
      "EnglishFillAnswer": null,
      "TrueFalseAnswer": false,
      "IsSameMcq": false,
